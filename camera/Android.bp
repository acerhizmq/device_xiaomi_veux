cc_library_shared {
    name: "camera.qcom",
    owner: "xiaomi",
    srcs: ["camera_shim_veux.cpp"],
    shared_libs: [
        "libbase",
        "libcutils",
        "libdl",
        "liblog",
        "libcamera_metadata",
        "libhardware",
        "libutils",
    ],
    include_dirs: [
        "system/media/camera/include",
        "hardware/libhardware/include",
    ],
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
        "-Wno-unused-parameter",
        "-Wno-unused-variable",
    ],
    relative_install_path: "hw",
    proprietary: true,
    sanitize: {
        cfi: false,
    },
}

cc_library_static {
    name: "libcameraservice_extension.veux",
    srcs: ["CameraProviderExtension.cpp"],
    shared_libs: [
        "libbase",
        "libcutils",
        "liblog",
    ],
    export_include_dirs: ["."],
}
