type camera_persist_file, vendor_persist_type, file_type;
vendor_internal_prop(vendor_camera_sensor_prop)

set_prop(hal_camera_default, vendor_camera_sensor_prop)
set_prop(hal_camera_default, vendor_camera_prop)
r_dir_file(hal_camera_default, camera_persist_file)
allow hal_camera_default mnt_vendor_file:dir search;

binder_call(hal_camera_default, system_server)

get_prop(hal_camera_default, vendor_persist_camera_prop)
get_prop(hal_camera_default, build_prop)
get_prop(hal_camera_default, vendor_camera_prop)
get_prop(hal_camera_default, vendor_video_prop)

allow hal_camera_default hal_graphics_mapper_hwservice:hwservice_manager find;
allow hal_camera_default fwk_sensor_hwservice:hwservice_manager find;

# Mute harmless default_prop log spams to avoid avc denials
dontaudit hal_camera_default default_prop:file read;

# Allow reading any general vendor prop
get_prop(hal_camera_default, vendor_default_prop)

# Generous file access for persist and vendor partitions
allow hal_camera_default mnt_vendor_file:file rw_file_perms;
allow hal_camera_default mnt_vendor_file:dir rw_dir_perms;

# Allow access to the custom SELinux label for the flash LED so the HAL can trigger it
allow hal_camera_default sysfs_torch:dir search;
allow hal_camera_default sysfs_torch:file rw_file_perms;
allow hal_camera_default sysfs_leds:dir search;
