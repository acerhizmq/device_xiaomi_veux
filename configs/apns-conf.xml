<!-- Veux Device APN Configuration
     Jio (Reliance Jio Infocomm) requires both jionet (data) and ims (VoLTE)
     APNs to be present. Without the ims APN, IMS registration fails entirely
     and Jio data shows connected but passes no traffic.

     Jio MCC: 405
     Jio MNC range: 840, 854-874 (circle-based allocation)
-->
<apns version="8">

    <!-- ================================================================
         JIO (Reliance Jio Infocomm) - MNC 840
    ================================================================ -->
    <apn carrier="Jio"
        mcc="405" mnc="840"
        apn="jionet"
        type="default,supl,ia"
        protocol="IPV4V6"
        roaming_protocol="IPV4V6"
        bearer_bitmask="LTE|NR"
        profile_id="0"
        modem_cognitive="true"
        user_visible="true" />

    <apn carrier="Jio IMS"
        mcc="405" mnc="840"
        apn="ims"
        type="ims"
        protocol="IPV4V6"
        roaming_protocol="IPV4V6"
        bearer_bitmask="LTE|NR"
        profile_id="2"
        modem_cognitive="true"
        user_visible="false" />

